# Production site origin (used for canonical URLs, Open Graph, and sitemap).
# Example: https://www.tarka.example.com
PUBLIC_SITE_URL=https://tarka.marketing.local

# HTTPS origin of your public Tarka lite deployment (no trailing slash).
# Leave unset during local dev if you only run Tarka on localhost.
# PUBLIC_DEMO_URL=https://demo.tarka.example.com

# Optional: override the default maintainer Loom walkthrough URL.
# PUBLIC_LOOM_URL=https://www.loom.com/share/2bc3dce78042444fb3216ca076a16fbc

# Optional: Plausible Analytics domain (public site hostname only, no https).
# PUBLIC_PLAUSIBLE_DOMAIN=www.tarka.example.com
