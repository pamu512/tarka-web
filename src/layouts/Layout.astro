---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
	noIndex?: boolean;
}

const {
	title,
	description = 'Tarka — open-source, modular fraud detection. Prove every signal.',
	ogImage = '/tarka-logo-full.svg',
	noIndex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteOg = new URL(ogImage, Astro.site).href;
const siteHref = Astro.site?.href ?? canonical.href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareSourceCode',
	name: 'Tarka',
	description,
	url: siteHref,
	codeRepository: 'https://github.com/pamu512/tarka',
	programmingLanguage: ['Python', 'TypeScript'],
	license: 'https://github.com/pamu512/tarka/blob/master/LICENSE',
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical.href} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:image" content={absoluteOg} />
		<meta property="og:image:alt" content="Tarka — Prove every signal." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={absoluteOg} />
		{
			import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN && (
				<script
					defer
					data-domain={import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN}
					src="https://plausible.io/js/script.js"
				/>
			)
		}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html {
		color-scheme: dark;
	}
</style>
