---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AudiencePathCards from '../components/AudiencePathCards.astro';

const demoUrl = import.meta.env.PUBLIC_DEMO_URL;
const github = 'https://github.com/pamu512/tarka';
const repo = github;
const sandboxGuide = `${repo}/blob/master/docs/docs/guides/sandbox-five-minute.md`;
const codespaces = `https://github.com/codespaces/new?hide_repo_select=true&ref=master&repo=pamu512%2Ftarka`;
const security = `${repo}/blob/master/SECURITY.md`;
const loomUrl =
	import.meta.env.PUBLIC_LOOM_URL ?? 'https://www.loom.com/share/2bc3dce78042444fb3216ca076a16fbc';
const loomEmbed = loomUrl.includes('/embed/')
	? loomUrl
	: loomUrl.replace(/loom\.com\/share\//, 'loom.com/embed/');
---

<Layout
	title="Tarka — Prove every signal."
	description="Open-source fraud detection for engineering, operations, and leadership: explainable decisions, modular stack, and controls you can own—without giving up the repo when you need to ship."
>
	<div class="page">
		<a class="skip-link" href="#main">Skip to main content</a>
		<Header />
		<main id="main">
			<section id="overview" class="hero" aria-labelledby="hero-title">
				<p class="eyebrow">Open-source fraud platform</p>
				<h1 id="hero-title">Prove every signal.</h1>
				<p class="lede">
					Tarka is modular fraud detection for teams that need real-time decisions, explainable outcomes, and
					investigations—without vendor lock-in.
				</p>
				<p class="hero-hint">
					<a href="#choose-role">Choose your path</a> (developer, operations, leader, or investor), or scroll for
					the full story, demo, and install paths.
				</p>
				<div class="actions">
					{
						demoUrl ? (
							<a class="btn primary" href={demoUrl} target="_blank" rel="noopener noreferrer">
								Try live demo
							</a>
						) : (
							<a class="btn primary" href="#demo">
								View demo
							</a>
						)
					}
					<a class="btn ghost" href={github} target="_blank" rel="noopener noreferrer">
						View on GitHub
					</a>
				</div>
			</section>

			<AudiencePathCards />

			<section class="grid" aria-labelledby="pillars-heading">
				<h2 id="pillars-heading" class="sr-only">What you get</h2>
				<article>
					<h3>Own the stack</h3>
					<p>
						Pick the modules you need—Decision API, cases, graph, ML, integrations—and run them where you
						already operate.
					</p>
				</article>
				<article>
					<h3>Explainable by design</h3>
					<p>
						Every signal is a hypothesis; decisions surface inference context and evidence your analysts and
						auditors can follow.
					</p>
				</article>
				<article>
					<h3>From analysts to automation</h3>
					<p>
						Case workflows and explainability for operators; APIs and SDKs when you need to embed scoring in
						your own services.
					</p>
				</article>
			</section>

			<section id="audience-developers" class="section audience audience-dev" tabindex="-1" aria-labelledby="aud-dev">
				<h2 id="aud-dev">For developers</h2>
				<p class="audience-lead">
					Ship scoring and case flows behind a stable surface area: evaluate, ingest, and extend with modules
					you actually need—not a monolithic black box.
				</p>
				<ul class="audience-list">
					<li>
						<strong>Integrate, don’t rip and replace</strong> — REST-shaped Decision API and typed clients so your
						services call one hub for decisions and context.
					</li>
					<li>
						<strong>Iterate locally</strong> — CLI installer, Docker Compose paths, and CI-visible quality gates
						in the open repository.
					</li>
					<li>
						<strong>See the contract</strong> — OpenAPI and SDKs track the same payloads your UI and automation
						use.
					</li>
				</ul>
				<p class="audience-cta">
					<a class="btn primary" href="#get-started">Install &amp; run</a>
					<a class="btn ghost" href={github} target="_blank" rel="noopener noreferrer">
						Browse the repo
					</a>
				</p>
			</section>

			<section
				id="audience-operations"
				class="section audience audience-ops"
				tabindex="-1"
				aria-labelledby="aud-ops"
			>
				<h2 id="aud-ops">For fraud &amp; risk operations</h2>
				<p class="audience-lead">
					Give analysts explainable decisions and structured case work—without waiting on a vendor roadmap for
					every rule change or integration.
				</p>
				<ul class="audience-list">
					<li>
						<strong>Show your work</strong> — Decisions carry inference context and evidence your team can defend
						in reviews and handoffs.
					</li>
					<li>
						<strong>Investigations first</strong> — Case-oriented flows, not only batch scores in a spreadsheet
						export.
					</li>
					<li>
						<strong>Integrate the real world</strong> — KYC, sanctions, device, CRM, and dispute paths through
						one integration story (exact adapters depend on what you enable).
					</li>
					<li>
						<strong>Own the operating reality</strong> — Self-hosted means <em>you</em> own change windows,
						capacity, and runbooks—plan staffing accordingly.
					</li>
				</ul>
				<p class="audience-cta">
					<a class="btn primary" href="#demo">Watch the walkthrough</a>
					<a class="btn ghost" href={security} target="_blank" rel="noopener noreferrer">
						Security disclosure
					</a>
				</p>
			</section>

			<section
				id="audience-leaders"
				class="section audience audience-leaders"
				tabindex="-1"
				aria-labelledby="aud-lead"
			>
				<h2 id="aud-lead">For program sponsors &amp; executives</h2>
				<p class="audience-lead">
					Reduce strategic risk from opaque vendor logic: keep core fraud decisions and evidence inside your
					organization’s control, with a path to audit and evolve.
				</p>
				<ul class="audience-list">
					<li>
						<strong>Escape lock-in on the core</strong> — Your team can audit, extend, and ship controls without
						being captive to a single vendor’s release train for the risk engine.
					</li>
					<li>
						<strong>Consolidate where it counts</strong> — Rules, ML, graph, and cases behind one decision
						surface—fewer brittle handoffs between point tools.
					</li>
					<li>
						<strong>Align risk and engineering</strong> — Shared artifacts (contracts, traces, case exports)
						that both sides can examine under pressure.
					</li>
					<li>
						<strong>Compliance-oriented posture</strong> — Traceability and documented dependencies are treated
						as first-class in the OSS program (not legal advice; map to your regime).
					</li>
				</ul>
				<div class="audience-note">
					<p>
						<strong>Total cost honesty:</strong> OSS avoids traditional license line items; you still budget for
						people, cloud or data-center capacity, and integration—not a fake “free lunch.”
					</p>
				</div>
				<p class="audience-cta">
					<a class="btn primary" href="#demo">See the product story</a>
					<a class="btn ghost" href="#why">Read the positioning</a>
				</p>
			</section>

			<section
				id="audience-investors"
				class="section audience audience-inv"
				tabindex="-1"
				aria-labelledby="aud-inv"
			>
				<h2 id="aud-inv">For investors &amp; strategic partners</h2>
				<p class="audience-lead">
					Tarka is open infrastructure for a regulated, high-stakes workflow: every signal is a hypothesis; every
					decision should be provable. Distribution starts with developers and GitHub—not a gated sales deck.
				</p>
				<ul class="audience-list">
					<li>
						<strong>Wedge</strong> — Modular fraud stack (rules, ML, graph, cases, integrations) behind a
						normalized API—teams adopt components before committing to a full platform swap.
					</li>
					<li>
						<strong>Thesis fit</strong> — Explainability and operator trust move budget in fraud; OSS lowers
						adoption friction and surfaces serious evaluators early.
					</li>
					<li>
						<strong>What to diligence</strong> — Public CI/security posture, release cadence, module depth, and
						ecosystem hooks (commercial adjacencies can sit beside OSS without confusion if messaged cleanly).
					</li>
				</ul>
				<div class="audience-note">
					<p>
						<strong>Early-stage candor:</strong> Traction metrics belong in conversation and materials suited to
						your stage—this site is intentionally product- and repo-forward, not a substitute for a data room.
					</p>
				</div>
				<p class="audience-cta">
					<a class="btn primary" href={github} target="_blank" rel="noopener noreferrer">
						Review the repository
					</a>
					<a class="btn ghost" href="#get-started">See how teams adopt</a>
				</p>
			</section>

			<section id="why" class="section why" aria-labelledby="why-heading">
				<h2 id="why-heading">Why Tarka</h2>
				<p class="intro">
					<em>Tarka</em> (Sanskrit तर्क) names disciplined hypothesis testing—fitting for a platform where every
					signal is a hypothesis and every decision should be provable.
				</p>

				<div class="subsection">
					<h3>Choose Tarka when you need to</h3>
					<ul>
						<li>
							<strong>Own and evolve controls</strong> — fraud logic your team can audit, extend, and ship
							without waiting on a black-box vendor.
						</li>
						<li>
							<strong>Unify rules, ML, and graph</strong> — one stack for scoring, entity insight, and case
							work—behind a normalized Decision API and typed clients.
						</li>
						<li>
							<strong>Support investigations</strong> — case workflows and explainability surfaces built for
							analysts, not only batch scores.
						</li>
						<li>
							<strong>Integrate widely</strong> — connect KYC, sanctions, device, CRM, or dispute tools through
							the integration layer instead of one-off scripts.
						</li>
						<li>
							<strong>Meet compliance expectations</strong> — traceability, security workflows, and
							documented dependencies as first-class concerns in the OSS repo.
						</li>
					</ul>
				</div>

				<div class="honest">
					<h3>When something simpler might be enough</h3>
					<p>
						Tarka may be more than you need if you only require a minimal single-rule workflow and do not need
						integrations, investigations, or governance depth. In that case, a lighter tool may be faster to
						operate.
					</p>
				</div>
			</section>

			<section id="demo" class="section demo" aria-labelledby="demo-heading">
				<h2 id="demo-heading">Experience the demo</h2>
				<p class="intro">
					The live sandbox is the full lite stack (frontend, Decision API, integration ingress). Shared demos may
					reset—treat data as ephemeral.
				</p>

				{
					demoUrl ? (
						<>
							<div class="banner" role="status">
								Shared demo environment — data may reset without notice.
							</div>
							<div class="frame-wrap">
								<iframe
									src={demoUrl}
									title="Tarka live demo"
									class="frame"
									loading="lazy"
									referrerpolicy="no-referrer-when-downgrade"
								/>
							</div>
							<p class="alt">
								<a href={demoUrl} target="_blank" rel="noopener noreferrer">
									Open demo in a new tab
								</a>{' '}
								if embedding is blocked by your browser or the demo host.
							</p>
						</>
					) : (
						<div class="placeholder">
							<p>
								<strong>No public demo URL configured.</strong> Set <code>PUBLIC_DEMO_URL</code> in your
								deployment environment to the HTTPS origin of your Tarka lite deployment (see{' '}
								<code>deploy/README.md</code> in this project).
							</p>
							<p>
								Until then, run Tarka locally with{' '}
								<code>docker compose -f deploy/docker-compose.lite.yml up -d --build</code> from the{' '}
								<a href={repo}>canonical repository</a>.
							</p>
						</div>
					)
				}

				<div class="video">
					<h3>Five-minute walkthrough</h3>
					<p class="muted">Sandbox flow, inference context, OSINT path, and case explainability.</p>
					<div class="loom">
						<iframe
							src={loomEmbed}
							title="Tarka walkthrough video"
							allow="fullscreen"
							style="border: none; width: 100%; height: 100%;"
						/>
					</div>
				</div>
			</section>

			<section id="get-started" class="section get-started" aria-labelledby="start-heading">
				<h2 id="start-heading">Get started</h2>
				<p class="intro">
					Everything below lives in the <a href={repo}>canonical repository</a>. For copy-paste ports, curls,
					and UI paths, use the <a href={sandboxGuide}>five-minute sandbox guide</a>.
				</p>

				<div class="subsection">
					<h3>1. Installer (Python 3.11+)</h3>
					<pre><code>git clone https://github.com/pamu512/tarka.git
cd tarka
python tarka.py install --lite</code></pre>
					<p>
						Use <code>python tarka.py install</code> for an interactive module pick, or <code>--all</code> for
						the full stack.
					</p>
				</div>

				<div class="subsection">
					<h3>2. Docker Compose (lite)</h3>
					<pre><code>git clone https://github.com/pamu512/tarka.git
cd tarka
docker compose -f deploy/docker-compose.lite.yml up -d --build</code></pre>
					<p>
						Typical local ports: frontend <code>3000</code>, decision API <code>8000</code>, integration
						ingress <code>8003</code>.
					</p>
				</div>

				<div class="subsection">
					<h3>3. Prebuilt sandbox image (optional)</h3>
					<pre><code>docker compose -f https://raw.githubusercontent.com/pamu512/tarka/master/deploy/docker-compose.sandbox.yml up -d</code></pre>
				</div>

				<div class="subsection">
					<h3>4. GitHub Codespaces</h3>
					<p>
						Open a cloud dev environment from the repo, then run the same Compose command.{' '}
						<a href={codespaces}>Create a Codespace</a>
						— ports <code>3000</code>, <code>8000</code>, <code>8002</code>, <code>8003</code> are forwarded per
						the devcontainer.
					</p>
				</div>
			</section>
		</main>
		<Footer />
	</div>

	<script is:inline>
		(function () {
			var params = new URLSearchParams(window.location.search);
			var r = params.get('role') || params.get('audience');
			var map = {
				developers: 'audience-developers',
				dev: 'audience-developers',
				developer: 'audience-developers',
				operations: 'audience-operations',
				ops: 'audience-operations',
				operation: 'audience-operations',
				leaders: 'audience-leaders',
				leader: 'audience-leaders',
				executives: 'audience-leaders',
				executive: 'audience-leaders',
				investors: 'audience-investors',
				investor: 'audience-investors',
			};
			if (!r || !map[r]) return;
			var id = map[r];
			requestAnimationFrame(function () {
				var el = document.getElementById(id);
				if (!el) return;
				el.focus({ preventScroll: true });
				el.scrollIntoView({ behavior: 'smooth', block: 'start' });
				try {
					var u = new URL(window.location.href);
					u.searchParams.delete('role');
					u.searchParams.delete('audience');
					window.history.replaceState({}, '', u.pathname + u.search + '#' + id);
				} catch (e) {
					window.location.hash = '#' + id;
				}
			});
		})();
	</script>
</Layout>

<style>
	.page {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	main {
		flex: 1;
		max-width: 1100px;
		margin: 0 auto;
		padding: 2.5rem 1.25rem 4rem;
		width: 100%;
	}

	.skip-link {
		position: absolute;
		left: -9999px;
		z-index: 100;
		padding: 0.5rem 1rem;
		background: var(--accent);
		color: var(--bg);
		font-weight: 600;
		border-radius: 0 0 8px 0;
	}

	.skip-link:focus {
		left: 1rem;
		top: 0.5rem;
		outline: 2px solid var(--accent-hover);
		outline-offset: 2px;
	}

	.hero {
		max-width: 44rem;
		margin-bottom: 2.5rem;
	}

	.eyebrow {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--accent);
		margin: 0 0 0.75rem;
	}

	.hero h1 {
		font-size: clamp(2rem, 5vw, 2.75rem);
		font-weight: 700;
		line-height: 1.15;
		margin: 0 0 1rem;
		letter-spacing: -0.02em;
	}

	.lede {
		font-size: 1.15rem;
		color: var(--text-muted);
		margin: 0 0 1rem;
	}

	.hero-hint {
		font-size: 0.95rem;
		color: var(--text-muted);
		margin: 0 0 1.5rem;
		max-width: 48ch;
		line-height: 1.5;
	}

	.hero-hint a {
		font-weight: 600;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1.25rem;
		border-radius: var(--radius);
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		border: 1px solid transparent;
		transition:
			background 0.15s,
			border-color 0.15s,
			color 0.15s;
	}

	.btn.primary {
		background: var(--accent);
		color: var(--bg);
	}

	.btn.primary:hover {
		background: var(--accent-hover);
		color: var(--bg);
	}

	.btn.ghost {
		border-color: var(--border);
		color: var(--text);
		background: transparent;
	}

	.btn.ghost:hover {
		border-color: var(--text-muted);
		background: var(--bg-elevated);
	}

	.grid {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		margin-bottom: 4rem;
	}

	.grid article {
		padding: 1.25rem 1.35rem;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--bg-elevated);
	}

	.grid h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.grid p {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-muted);
	}

	.section {
		margin-bottom: 4rem;
		scroll-margin-top: 5rem;
	}

	.section h2 {
		font-size: clamp(1.5rem, 3vw, 1.85rem);
		margin: 0 0 0.75rem;
	}

	.section .intro {
		font-size: 1.05rem;
		color: var(--text-muted);
		margin: 0 0 1.5rem;
		max-width: 52ch;
	}

	.why .intro {
		font-size: 1.1rem;
	}

	.subsection {
		margin-bottom: 2rem;
	}

	.subsection h3 {
		font-size: 1.1rem;
		margin: 0 0 0.65rem;
	}

	.subsection ul {
		margin: 0;
		padding-left: 1.25rem;
		color: var(--text-muted);
	}

	.subsection li {
		margin-bottom: 0.65rem;
	}

	.subsection li strong {
		color: var(--text);
	}

	.honest {
		padding: 1.25rem 1.35rem;
		border-radius: var(--radius);
		border: 1px dashed var(--border);
		background: rgba(56, 189, 248, 0.06);
	}

	.honest h3 {
		font-size: 1rem;
		margin: 0 0 0.5rem;
	}

	.honest p {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	.audience {
		padding: 1.5rem 1.5rem 1.65rem;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: rgba(18, 26, 46, 0.65);
	}

	.audience-dev {
		border-left: 4px solid #38bdf8;
	}
	.audience-ops {
		border-left: 4px solid #a78bfa;
	}
	.audience-leaders {
		border-left: 4px solid #fbbf24;
	}
	.audience-inv {
		border-left: 4px solid #34d399;
	}

	.audience-lead {
		font-size: 1.05rem;
		color: var(--text-muted);
		margin: 0 0 1.25rem;
		max-width: 58ch;
		line-height: 1.55;
	}

	.audience-list {
		margin: 0 0 1.25rem;
		padding-left: 1.25rem;
		color: var(--text-muted);
	}

	.audience-list li {
		margin-bottom: 0.65rem;
		line-height: 1.5;
	}

	.audience-list strong {
		color: var(--text);
	}

	.audience-note {
		padding: 1rem 1.1rem;
		border-radius: 8px;
		background: rgba(15, 23, 42, 0.6);
		border: 1px solid var(--border);
		margin-bottom: 1.25rem;
	}

	.audience-note p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	.audience-note strong {
		color: var(--text);
	}

	.audience-cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
	}

	.demo .intro {
		max-width: none;
	}

	.banner {
		font-size: 0.85rem;
		padding: 0.5rem 0.85rem;
		border-radius: 8px;
		background: rgba(251, 191, 36, 0.12);
		border: 1px solid rgba(251, 191, 36, 0.35);
		color: #fde68a;
		margin-bottom: 1rem;
	}

	.frame-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		max-height: min(72vh, 640px);
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--border);
		background: var(--bg-elevated);
	}

	.frame {
		width: 100%;
		height: 100%;
		border: 0;
	}

	.alt {
		font-size: 0.9rem;
		color: var(--text-muted);
		margin-top: 0.75rem;
	}

	.placeholder {
		padding: 1.25rem 1.35rem;
		border-radius: var(--radius);
		border: 1px solid var(--border);
		background: var(--bg-elevated);
		margin-bottom: 2rem;
	}

	.placeholder p {
		margin: 0 0 0.75rem;
		color: var(--text-muted);
	}

	.video {
		margin-top: 2.5rem;
	}

	.video h3 {
		font-size: 1.15rem;
		margin: 0 0 0.35rem;
	}

	.muted {
